# === Core ===
DATABASE_URL=postgresql://bn:bn@localhost:5432/bullshit_notes?schema=public
REDIS_URL=redis://localhost:6379

# === Auth ===
# Use a long random string. NEVER reuse the example value.
JWT_SECRET=change-me-to-a-long-random-secret-string
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=30

# === Crypto ===
# 32-byte key, base64 encoded. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MASTER_KEY=change-me-base64-32-bytes-key================

# === Object storage (MinIO / S3) ===
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=bullshit-notes
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1

# === App ===
ALLOW_SIGNUP=true
APP_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=info

# === Prompt 2 services (all optional) ===
# NVD API 2.0 key. Without it the CVE sync sleeps 6s between pages (5 req/30s);
# with it, 50 req/30s.
NVD_API_KEY=
# Timeout for streaming AI provider calls (ms). Non-stream test calls use 15s.
AI_REQUEST_TIMEOUT_MS=120000
# How many Chromium instances the PDF export worker keeps warm.
EXPORT_BROWSER_POOL_SIZE=1
# Per-delivery HTTP timeout for outbound webhook POSTs (ms).
WEBHOOK_TIMEOUT_MS=10000

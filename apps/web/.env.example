# Copy to .env.local for local development.

# Demo mode uses seeded data in the browser (no backend needed). Set to "false"
# to use the real Supabase-backed API.
NEXT_PUBLIC_DEMO_MODE=true

# Leave empty when the API route handlers are served from the same origin
# (the default on Netlify). Only set this to point at a different API origin.
NEXT_PUBLIC_API_BASE_URL=

# --- Supabase (required when NEXT_PUBLIC_DEMO_MODE=false) ---
# Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret — server-side only, never exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=
